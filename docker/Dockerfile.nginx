FROM node:20-alpine AS build
WORKDIR /site
COPY package*.json ./
RUN npm ci || npm i
COPY . .

# Build args for metadata injection
ARG GIT_SHA
ARG GIT_TAG
ARG GIT_BRANCH
ARG IMAGE_REF
ENV GIT_SHA=$GIT_SHA \
    GIT_TAG=$GIT_TAG \
    GIT_BRANCH=$GIT_BRANCH \
    IMAGE_REF=$IMAGE_REF

RUN npm run build

FROM nginx:alpine
COPY --from=build /site/dist /usr/share/nginx/html
COPY nginx/health.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

