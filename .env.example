# FloodSight Environment Variables
# Copy this file to .env and fill in your values

# Application
NODE_ENV=production
PORT=5173

# API Configuration
VITE_API_BASE_URL=https://api.floodsight.example.com
VITE_API_KEY=your_api_key_here

# Map Configuration
VITE_MAP_PROVIDER=openstreetmap
VITE_MAP_DEFAULT_LAT=51.5074
VITE_MAP_DEFAULT_LNG=-0.1278
VITE_MAP_DEFAULT_ZOOM=11

# External Data Sources
VITE_WEATHER_API_KEY=your_weather_api_key
VITE_FLOOD_DATA_API=https://environment.data.gov.uk/flood-monitoring

# Analytics (Optional)
VITE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Feature Flags
VITE_ENABLE_ALERTS=true
VITE_ENABLE_FORECASTING=true
VITE_ENABLE_HISTORICAL_DATA=true

# Security
COOKIE_SECRET=change_this_to_a_random_string
SESSION_SECRET=change_this_to_another_random_string

# Deployment
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
VERCEL_TOKEN=

# Docker
DOCKER_IMAGE_NAME=floodsight
DOCKER_IMAGE_TAG=latest
DOCKER_REGISTRY=ghcr.io/yourusername

# Kubernetes
K8S_NAMESPACE=floodsight
K8S_REPLICAS=3
K8S_DOMAIN=floodsight.example.com
