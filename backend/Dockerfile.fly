# Fly.io Dockerfile for FloodSight Backend API
# Multi-stage build for optimized image size

# ============================================
# Stage 1: Builder - Install dependencies
# ============================================
FROM python:3.11-slim as builder

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# ============================================
# Stage 2: Runtime - Minimal production image
# ============================================
FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user FIRST
RUN useradd -m -u 1000 floodsight

# Copy Python packages from builder to user directory
COPY --from=builder --chown=floodsight:floodsight /root/.local /home/floodsight/.local
ENV PATH=/home/floodsight/.local/bin:$PATH

# Copy application code
COPY --chown=floodsight:floodsight app/ /app/app/
COPY --chown=floodsight:floodsight alembic/ /app/alembic/
COPY --chown=floodsight:floodsight alembic.ini /app/

# Switch to non-root user
USER floodsight

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/v1/health || exit 1

# Run the application
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]

