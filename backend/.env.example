# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/floodsight
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Application
APP_NAME=FloodSight API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://floodsight.vercel.app"]

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Supabase (JWT Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/keys

# Prefect
PREFECT_API_URL=http://prefect:4200

# Metrics
METRICS_ENABLED=true

# ECMWF/GloFAS (for future use)
ECMWF_API_KEY=your-api-key
ECMWF_API_URL=https://cds.climate.copernicus.eu/api/v2
