# Backend Secrets Template
# 
# IMPORTANT: This is a template file. DO NOT commit the actual secrets file!
# 
# To use:
# 1. Copy this file: cp backend-secrets.yaml.example backend-secrets.yaml
# 2. Fill in the actual values (replace <PLACEHOLDER> values)
# 3. Apply: kubectl apply -f backend-secrets.yaml
# 4. The actual backend-secrets.yaml is gitignored
#
apiVersion: v1
kind: Secret
metadata:
  name: floodsight-backend-secrets
  labels:
    app: floodsight
    component: backend
type: Opaque
stringData:
  # Database connection string
  # Format: postgresql+asyncpg://user:password@host:port/database
  database-url: "postgresql+asyncpg://postgres:password@postgres-service:5432/floodsight"
  
  # Supabase JWT authentication (optional)
  # Get from: https://app.supabase.com/project/<project-id>/settings/api
  supabase-jwks-url: "https://<your-project>.supabase.co/auth/v1/keys"
  supabase-jwt-secret: "<your-jwt-secret>"
  supabase-anon-key: "<your-anon-key>"
  supabase-service-role-key: "<your-service-role-key>"
  
  # ECMWF CDS API credentials for GloFAS data
  # Register at: https://cds.climate.copernicus.eu/
  cds-api-key: "<your-cds-api-key>"
  cds-api-url: "https://cds.climate.copernicus.eu/api/v2"
  
  # Email notifications (SMTP)
  smtp-host: "smtp.gmail.com"
  smtp-port: "587"
  smtp-user: "<your-email@gmail.com>"
  smtp-password: "<your-app-password>"
  smtp-from: "noreply@floodsight.com"
  
  # SMS notifications (Twilio)
  twilio-account-sid: "<your-twilio-account-sid>"
  twilio-auth-token: "<your-twilio-auth-token>"
  twilio-from-number: "+1234567890"
  
  # Push notifications (Firebase Cloud Messaging)
  fcm-server-key: "<your-fcm-server-key>"
  fcm-credentials-json: |
    {
      "type": "service_account",
      "project_id": "your-project",
      "private_key_id": "...",
      "private_key": "...",
      "client_email": "...",
      "client_id": "...",
      "auth_uri": "https://accounts.google.com/o/oauth2/auth",
      "token_uri": "https://oauth2.googleapis.com/token"
    }
  
  # Push notifications (OneSignal - alternative)
  onesignal-app-id: "<your-onesignal-app-id>"
  onesignal-api-key: "<your-onesignal-api-key>"
  
  # Telegram Bot (optional)
  telegram-bot-token: "<your-telegram-bot-token>"
  
  # Webhook URLs (optional)
  discord-webhook-url: "https://discord.com/api/webhooks/..."
  slack-webhook-url: "https://hooks.slack.com/services/..."
  
  # Redis connection (if caching is enabled)
  redis-url: "redis://floodsight-redis:6379/0"
  
  # API keys for external services (optional)
  openweathermap-api-key: "<your-openweathermap-key>"
  
  # Encryption key for sensitive data
  secret-key: "<generate-random-secret-key>"
  # Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

