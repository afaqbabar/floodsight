{
  "dashboard": {
    "title": "FloodSight Application Metrics",
    "tags": ["floodsight", "fastapi", "application"],
    "timezone": "browser",
    "editable": true,
    "panels": [
      {
        "id": 1,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "type": "graph",
        "title": "HTTP Requests per Second",
        "targets": [
          {
            "expr": "rate(floodsight_requests_total[5m])",
            "legendFormat": "{{method}} {{endpoint}} ({{status}})",
            "refId": "A"
          }
        ],
        "yaxes": [{ "format": "reqps", "label": "Requests/s" }, { "format": "short" }]
      },
      {
        "id": 2,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "type": "graph",
        "title": "Request Duration (p95)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(floodsight_request_duration_seconds_bucket[5m]))",
            "legendFormat": "{{method}} {{endpoint}}",
            "refId": "A"
          }
        ],
        "yaxes": [{ "format": "s", "label": "Duration" }, { "format": "short" }]
      },
      {
        "id": 3,
        "gridPos": { "h": 7, "w": 8, "x": 0, "y": 8 },
        "type": "stat",
        "title": "Total Requests",
        "targets": [
          {
            "expr": "sum(floodsight_requests_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 1000, "color": "yellow" },
                { "value": 10000, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "gridPos": { "h": 7, "w": 8, "x": 8, "y": 8 },
        "type": "stat",
        "title": "Memory Usage",
        "targets": [
          {
            "expr": "floodsight_process_memory_bytes / 1024 / 1024",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "decmbytes",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 200, "color": "yellow" },
                { "value": 500, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "gridPos": { "h": 7, "w": 8, "x": 16, "y": 8 },
        "type": "stat",
        "title": "CPU Usage",
        "targets": [
          {
            "expr": "floodsight_process_cpu_percent",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 50, "color": "yellow" },
                { "value": 80, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
        "type": "graph",
        "title": "Memory Usage Over Time",
        "targets": [
          {
            "expr": "floodsight_process_memory_bytes / 1024 / 1024",
            "legendFormat": "Memory (MB)",
            "refId": "A"
          }
        ],
        "yaxes": [{ "format": "decmbytes", "label": "Memory" }, { "format": "short" }]
      },
      {
        "id": 7,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
        "type": "graph",
        "title": "CPU Usage Over Time",
        "targets": [
          {
            "expr": "floodsight_process_cpu_percent",
            "legendFormat": "CPU %",
            "refId": "A"
          }
        ],
        "yaxes": [{ "format": "percent", "label": "CPU Usage" }, { "format": "short" }]
      },
      {
        "id": 8,
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
        "type": "table",
        "title": "HTTP Status Codes",
        "targets": [
          {
            "expr": "sum by (status, method, endpoint) (floodsight_requests_total)",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": { "Time": true },
              "indexByName": {},
              "renameByName": {
                "endpoint": "Endpoint",
                "method": "Method",
                "status": "Status",
                "Value": "Count"
              }
            }
          }
        ]
      }
    ],
    "refresh": "5s",
    "schemaVersion": 27,
    "style": "dark",
    "time": { "from": "now-1h", "to": "now" },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    },
    "version": 1
  },
  "folderId": 0,
  "overwrite": true
}
